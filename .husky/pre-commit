# Fail fast if gitleaks is missing.
command -v gitleaks >/dev/null 2>&1 || {
  echo "gitleaks not found in PATH. Install with 'brew install gitleaks'." >&2
  exit 1
}

# Scan staged content only and hide secrets in output.
gitleaks protect --staged --redact --no-banner
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "Gitleaks found potential secrets in staged changes."
  echo "Fix or unstage the offending lines, then commit again."
  echo "Tip: run 'npm run scan:secrets' to scan entire repo."
  exit $status
fi
